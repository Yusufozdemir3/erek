<?xml version="1.0" encoding="utf-8"?>
<!-- The scrolling list widgets (Bugün, Sayaç, Görevler, Hedefler): a header and a
     ListView whose rows WidgetLists.kt builds. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

  <ImageView
      android:id="@+id/l_bg"
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:scaleType="fitXY"
      android:src="@drawable/erek_widget_card" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="match_parent"
      android:orientation="vertical"
      android:paddingStart="14dp"
      android:paddingEnd="8dp"
      android:paddingTop="12dp"
      android:paddingBottom="8dp">

    <LinearLayout
        android:id="@+id/l_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingEnd="6dp">
      <TextView
          android:id="@+id/l_title"
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:ellipsize="end"
          android:maxLines="1"
          android:textSize="16sp"
          android:textStyle="bold" />
      <TextView
          android:id="@+id/l_summary"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:maxLines="1"
          android:textSize="13sp"
          android:textStyle="bold" />
    </LinearLayout>

    <ListView
        android:id="@+id/l_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:scrollbars="none" />

    <TextView
        android:id="@+id/l_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="6dp"
        android:textSize="13sp"
        android:visibility="gone" />
  </LinearLayout>
</FrameLayout>
