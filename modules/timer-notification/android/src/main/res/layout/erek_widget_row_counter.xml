<?xml version="1.0" encoding="utf-8"?>
<!-- A Sayaç row: dot, title over "3/8 unit", and the +1 button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="46dp"
    android:orientation="horizontal"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:paddingEnd="6dp">
  <ImageView
      android:id="@+id/c_dot"
      android:layout_width="10dp"
      android:layout_height="10dp"
      android:src="@drawable/timer_oval" />
  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_marginStart="10dp"
      android:layout_marginEnd="8dp"
      android:layout_weight="1"
      android:orientation="vertical">
    <TextView
        android:id="@+id/c_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="14sp" />
    <TextView
        android:id="@+id/c_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textSize="12sp"
        android:textStyle="bold" />
  </LinearLayout>
  <FrameLayout
      android:layout_width="48dp"
      android:layout_height="36dp">
    <ImageView
        android:id="@+id/c_btn_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:src="@drawable/erek_widget_pill" />
    <TextView
        android:id="@+id/c_btn_text"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:text="+1"
        android:textSize="15sp"
        android:textStyle="bold" />
  </FrameLayout>
</LinearLayout>
