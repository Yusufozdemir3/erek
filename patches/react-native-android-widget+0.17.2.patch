+    // MIUI/HyperOS reports a widget size larger than its visible frame. The app
+    // leaves the same strip empty (src/widget/widgetInset.ts), so tap areas are
+    // measured from the visible right edge, not the reported one.
+    private static int visibleDp(int reportedDp) {
+        String maker = (Build.MANUFACTURER + " " + Build.BRAND).toLowerCase();
+        boolean miui = maker.contains("xiaomi") || maker.contains("redmi") || maker.contains("poco");
+        if (!miui) return reportedDp;
+        return reportedDp - Math.max(16, Math.round(reportedDp * 0.08f));
+    }
