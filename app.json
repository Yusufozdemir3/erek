{
  "expo": {
    "name": "Erek",
    "slug": "habit-app",
    "owner": "yusufozdemir",
    "version": "1.3.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "habitapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erek"
    },
    "android": {
      "package": "com.erek",
      "versionCode": 26,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#161412"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Room databases (WorkManager, used by the widgets) are created by reflection.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "./plugins/withForceDarkDisabled",
      "./plugins/withoutUnusedPermissions",
      "./plugins/withBackupRules",
      "./plugins/withReleaseSigning",
      "./plugins/withWindowsCmake",
      "./plugins/withR8CompatMode",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ErekToday",
              "previewImage": "./assets/widget-previews/today.png",
              "label": "Erek — Bugün",
              "description": "Bugünün alışkanlıkları — dokunarak işaretle",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ErekTasks",
              "previewImage": "./assets/widget-previews/tasks.png",
              "label": "Erek — Görevler",
              "description": "Bugünün görevleri — dokunarak tamamla",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ErekGoals",
              "previewImage": "./assets/widget-previews/goals.png",
              "label": "Erek — Hedefler",
              "description": "Açık hedeflerin ve ilerlemen",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ErekQuickAdd",
              "previewImage": "./assets/widget-previews/quickadd.png",
              "label": "Erek — Hızlı görev",
              "description": "Tek dokunuşla yeni görev ekle",
              "minWidth": "180dp",
              "minHeight": "40dp",
              "targetCellWidth": 3,
              "targetCellHeight": 1,
              "resizeMode": "horizontal",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ErekCounter",
              "previewImage": "./assets/widget-previews/counter.png",
              "label": "Erek — Sayaç",
              "description": "Su, sayfa gibi sayılı alışkanlıklara tek dokunuşla +1",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1389231740794130~1288487312"
        }
      ],
      "expo-secure-store",
      "expo-speech-recognition",
      "./plugins/withOptionalMicrophone"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2189a879-9482-4567-a2c4-e2c16fe4e983"
      }
    }
  }
}
