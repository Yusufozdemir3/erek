{
  "expo": {
    "name": "Habit App",
    "slug": "habit-app",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "habitapp",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habitapp.mobile"
    },
    "android": {
      "package": "com.habitapp.mobile"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
