{
  "expo": {
    "name": "Erek",
    "slug": "habit-app",
    "owner": "yusufozdemir",
    "version": "1.4.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "habitapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erek"
    },
    "android": {
      "package": "com.erek",
      "versionCode": 27,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      },
      "permissions": [
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F4F1EA",
          "dark": {
            "image": "./assets/splash-icon-dark.png",
            "backgroundColor": "#161412"
          }
        }
      ],
      "expo-notifications",
      [
        "expo-build-properties",
        {
          "android": {
            "targetSdkVersion": 36,
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Room databases (WorkManager, used by the widgets) are created by reflection.\n-keep class * extends androidx.room.RoomDatabase { <init>(); }"
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "./plugins/withForceDarkDisabled",
      "./plugins/withoutUnusedPermissions",
      "./plugins/withBackupRules",
      "./plugins/withReleaseSigning",
      "./plugins/withWindowsCmake",
      "./plugins/withR8CompatMode",
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1389231740794130~1288487312"
        }
      ],
      "expo-secure-store",
      "expo-speech-recognition",
      "./plugins/withOptionalMicrophone"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2189a879-9482-4567-a2c4-e2c16fe4e983"
      }
    }
  }
}
