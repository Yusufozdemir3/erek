{
  "expo": {
    "name": "Erek",
    "slug": "habit-app",
    "owner": "yusufozdemir",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "habitapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F4F1EA"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.erek"
    },
    "android": {
      "package": "com.erek",
      "versionCode": 11,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#F4F1EA"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-asset",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0"
          }
        }
      ],
      "expo-localization",
      "expo-font",
      "./plugins/withForceDarkDisabled",
      "./plugins/withoutUnusedPermissions",
      "./plugins/withBackupRules",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ErekToday",
              "label": "Erek — Bugün",
              "description": "Bugüne planlı alışkanlıkların ve tamamlanma durumun",
              "minWidth": "180dp",
              "minHeight": "110dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      "@react-native-google-signin/google-signin",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1389231740794130~1288487312"
        }
      ],
      "./plugins/withAdsCompatibleGmsAds"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "2189a879-9482-4567-a2c4-e2c16fe4e983"
      }
    }
  }
}
