# Supabase bulut senkron kimlik bilgileri.
# Bu dosyayı ".env" olarak kopyalayıp değerleri doldur.
# Supabase panelinde: Project Settings > API bölümünden alınır.
# Not: EXPO_PUBLIC_ önekli değişkenler istemciye gömülür; anon key public-safe'dir
# (veriyi RLS korur). Değiştirince Expo'yu yeniden başlat: npx expo start -c

EXPO_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Sentry hata izleme (isteğe bağlı). Boş bırakılırsa Sentry tamamen devre
# dışı kalır (src/lib/sentry.ts). sentry.io projesinde: Settings > Client Keys (DSN).
# NOT: Yalnız DSN girmek runtime hataları yakalar ama panelde trace'ler MINIFIED
# olur. Okunaklı trace için app.json'a Sentry plugin'ini geri ekle + EAS'te
# SENTRY_AUTH_TOKEN secret'ı tanımla (bkz. src/lib/sentry.ts başlığı).
EXPO_PUBLIC_SENTRY_DSN=
